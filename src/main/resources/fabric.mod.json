{
	"schemaVersion": 1,
	"id": "harvest-mod",
	"version": "${version}",
	"name": "Harvest Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/harvest-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.HarvestMod"
		],
		"client": [
			"com.example.client.HarvestModClient"
		]
	},
	"mixins": [
		"harvest-mod.mixins.json",
		{
			"config": "harvest-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.9",
		"java": ">=21",
		"fabric-api": "*"
	}
}